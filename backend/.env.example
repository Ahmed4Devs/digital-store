# -----------------------------------------------------------------------------
# Digital Products Store - Environment Configuration Template
# -----------------------------------------------------------------------------
# Allowed APP_ENV values: local | test | production
# In production:
#   - PAYMENT_MODE must be set to 'disabled' (startup fails if set to 'mock')
#   - SESSION_SECURE must be true (requires HTTPS)
#   - APP_DEBUG must be false
# -----------------------------------------------------------------------------

# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=change-this-to-a-secure-random-64-character-hex-secret-in-production

# Payment Simulation Gate (Options: mock [local/test only] | disabled [mandatory for production])
PAYMENT_MODE=mock

# Database Connection (MySQL 8.4 LTS / 8.0+ with InnoDB and utf8mb4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_store
DB_USERNAME=store_user
DB_PASSWORD=store_secret_password

# Session & Security Settings
SESSION_SECURE=false
SESSION_LIFETIME=86400
COOKIE_DOMAIN=

# CORS Configuration (Exact allowlist - comma separated origins, no wildcard '*')
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Storage Paths (Local private digital asset storage outside web root)
PRIVATE_STORAGE_PATH=storage/digital_assets
